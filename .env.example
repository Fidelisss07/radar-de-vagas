# Copie para .env e preencha. O .env não vai para o Git.
#
# Sem estas variáveis o projeto grava no SQLite local, o que é suficiente para
# desenvolver. Com elas, passa a gravar no Supabase.

# Painel do Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Painel do Supabase → Project Settings → API Keys → service_role
#
# ATENÇÃO: esta chave ignora as políticas de segurança das tabelas. Ela só pode
# viver no servidor — nunca em código que chega ao navegador, nunca no Git.
SUPABASE_SERVICE_KEY=

# Chave pública, usada pelo site para ler. Pode aparecer no navegador: as
# políticas do banco só liberam leitura para ela.
SUPABASE_ANON_KEY=

# Caminho do banco local, quando não estiver usando Supabase
RADAR_BANCO=dados/radar.db
